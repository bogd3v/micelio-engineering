{
  "name": "@micelio/eslint-config",
  "version": "0.1.2",
  "description": "The ESLint flat config of the Micelio repositories, the licence allowlist behind lint:licenses and lint:standard.",
  "license": "MIT-0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bogd3v/micelio-engineering.git",
    "directory": "packages/eslint-config"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./licenses.json": "./licenses.json",
    "./package.json": "./package.json",
    "./standard-hashes.json": "./standard-hashes.json"
  },
  "files": [
    "dist",
    "licenses.json",
    "standard-hashes.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^65.4.2",
    "eslint-plugin-tsdoc": "0.5.4",
    "typescript-eslint": "^8.71.2"
  },
  "peerDependencies": {
    "eslint": "^10.12.0",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "micelio-lint-standard": "./dist/lint-standard.js"
  },
  "devDependencies": {
    "@types/node": "^22.20.5"
  }
}
