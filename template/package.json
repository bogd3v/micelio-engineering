{
  "name": "{{package}}",
  "version": "0.1.0",
  "description": "{{description}}",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsc -b tsconfig.build.json --watch",
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:licenses": "node scripts/check-licenses.mjs",
    "lint:standard": "micelio-lint-standard",
    "lint:ee": "micelio-lint-ee --allow package-lock.json",
    "lint:unused": "knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:coverage && npm run lint:licenses && npm run lint:standard && npm run lint:ee && npm run lint:unused"
  },
  "devDependencies": {
    "@micelio/eslint-config": "^{{eslint-config-version}}",
    "@micelio/prettier-config": "^{{prettier-config-version}}",
    "@micelio/tsconfig": "^{{tsconfig-version}}",
    "@types/node": "{{types-node}}",
    "@vitest/coverage-v8": "{{vitest}}",
    "eslint": "{{eslint}}",
    "knip": "{{knip}}",
    "prettier": "{{prettier}}",
    "typescript": "{{typescript}}",
    "vitest": "{{vitest}}"
  },
  "prettier": "@micelio/prettier-config"
}
